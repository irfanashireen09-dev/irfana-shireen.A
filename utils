from io import BytesIO
import re

from docx import Document
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.shared import Inches, Pt

from fpdf import FPDF


def _split_sections(text: str):
    return [line.strip() for line in text.splitlines() if line.strip()]


def format_txt(text: str) -> bytes:
    return text.encode("utf-8")


def format_docx(
    text: str,
    doc_type: str,
    branding: str = "LegalEase"
) -> bytes:

    doc = Document()

    section = doc.sections[0]
    section.top_margin = Inches(0.7)
    section.bottom_margin = Inches(0.7)
    section.left_margin = Inches(0.8)
    section.right_margin = Inches(0.8)

    styles = doc.styles
    styles["Normal"].font.name = "Times New Roman"
    styles["Normal"].font.size = Pt(11)

    branding_paragraph = doc.add_paragraph()
    branding_paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER

    run = branding_paragraph.add_run(branding)
    run.bold = True
    run.font.size = Pt(14)

    title = doc.add_paragraph()
    title.alignment = WD_ALIGN_PARAGRAPH.CENTER

    run = title.add_run(doc_type.upper())
    run.bold = True
    run.font.size = Pt(16)

    for line in _split_sections(text):

        if re.match(r"^(\d+[.)]|[A-Z][A-Z\s]{4,}:?)", line):
            paragraph = doc.add_paragraph()
            run = paragraph.add_run(line)
            run.bold = True

        elif line.startswith(("- ", "* ")):
            doc.add_paragraph(
                line[2:].strip(),
                style="List Bullet"
            )

        else:
            doc.add_paragraph(line)

    table = doc.add_table(rows=1, cols=2)
    table.alignment = WD_TABLE_ALIGNMENT.CENTER
    table.style = "Table Grid"

    table.rows[0].cells[0].text = "Document"
    table.rows[0].cells[1].text = doc_type

    new_row = table.add_row()
    new_row.cells[0].text = "Generated by"
    new_row.cells[1].text = branding

    footer = section.footer.paragraphs[0]
    footer.alignment = WD_ALIGN_PARAGRAPH.CENTER

    footer_run = footer.add_run(
        f"{branding} | AI-generated draft - review before use"
    )
    footer_run.font.size = Pt(8)

    output = BytesIO()
    doc.save(output)

    return output.getvalue()


class LegalPDF(FPDF):

    def __init__(self, branding: str):
        super().__init__()
        self.branding = branding

    def header(self):
        self.set_font("Helvetica", "B", 10)
        self.cell(0, 8, self.branding, align="C")
        self.ln(7)

    def footer(self):
        self.set_y(-15)
        self.set_font("Helvetica", "I", 8)

        self.cell(
            0,
            10,
            f"{self.branding} | AI-generated draft - "
            f"review before use | Page {self.page_no()}",
            align="C"
        )


def format_pdf(
    text: str,
    doc_type: str,
    branding: str = "LegalEase"
) -> bytes:

    pdf = LegalPDF(branding)

    pdf.set_auto_page_break(
        auto=True,
        margin=18
    )

    pdf.add_page()

    pdf.set_font("Helvetica", "B", 16)
    pdf.multi_cell(
        0,
        9,
        doc_type.upper(),
        align="c"
    )

    pdf.ln(4)

